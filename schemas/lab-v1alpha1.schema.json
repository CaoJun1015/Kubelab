        "type": {
          "const": "pvc_status",
          "title": "Type",
          "type": "string"
        },
        "unmetMessage": {
          "minLength": 1,
          "title": "Unmetmessage",
          "type": "string"
        }
      },
      "required": [
        "id",
        "timeoutSeconds",
        "unmetMessage",
        "type",
        "name",
        "expectedPhase"
      ],
      "title": "PvcStatusCheck",
      "type": "object"
    },
    "ResourceExistsCheck": {
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "minLength": 1,
          "title": "Apiversion",
          "type": "string"
        },
        "id": {
          "maxLength": 63,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9-]{1,62}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 253,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$",
          "title": "Name",
          "type": "string"
        },
        "timeoutSeconds": {
          "maximum": 120,
          "minimum": 1,
          "title": "Timeoutseconds",
          "type": "integer"
        },
        "type": {
          "const": "resource_exists",
          "title": "Type",
          "type": "string"
        },
        "unmetMessage": {
          "minLength": 1,
          "title": "Unmetmessage",
          "type": "string"
        }
      },
      "required": [
        "id",
        "timeoutSeconds",
        "unmetMessage",
        "type",
        "apiVersion",
        "kind",
        "name"
      ],
      "title": "ResourceExistsCheck",
      "type": "object"
    },
    "ServiceEndpointCountCheck": {
      "additionalProperties": false,
      "properties": {
        "exactly": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exactly"
        },
        "id": {
          "maxLength": 63,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9-]{1,62}$",
          "title": "Id",
          "type": "string"
        },
        "maximum": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "minimum": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "name": {
          "maxLength": 253,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$",
          "title": "Name",
          "type": "string"
        },
        "timeoutSeconds": {
          "maximum": 120,
          "minimum": 1,
          "title": "Timeoutseconds",

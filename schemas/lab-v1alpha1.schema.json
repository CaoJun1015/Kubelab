        },
        "difficulty": {
          "enum": [
            "beginner",
            "intermediate",
            "advanced"
          ],
          "title": "Difficulty",
          "type": "string"
        },
        "durationMinutes": {
          "maximum": 180,
          "minimum": 5,
          "title": "Durationminutes",
          "type": "integer"
        },
        "id": {
          "maxLength": 40,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9-]{2,39}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "tags": {
          "items": {
            "maxLength": 63,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "difficulty",
        "durationMinutes",
        "category",
        "tags"
      ],
      "title": "LabMetadata",
      "type": "object"

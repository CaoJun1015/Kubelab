{
  "$defs": {
    "ConfigValueCheck": {
      "additionalProperties": false,
      "properties": {
        "expectedValue": {
          "title": "Expectedvalue",
          "type": "string"
        },
        "id": {
          "maxLength": 63,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9-]{1,62}$",
          "title": "Id",
          "type": "string"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "sourceKind": {
          "enum": [
            "ConfigMap",
            "Secret"
          ],
          "title": "Sourcekind",
          "type": "string"
        },
        "sourceName": {
          "maxLength": 253,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$",
          "title": "Sourcename",
          "type": "string"
        },
        "timeoutSeconds": {
          "maximum": 120,
          "minimum": 1,
          "title": "Timeoutseconds",
          "type": "integer"
        },
        "type": {
          "const": "config_value",
          "title": "Type",
          "type": "string"
        },
        "unmetMessage": {
          "minLength": 1,
          "title": "Unmetmessage",
          "type": "string"
        }
      },
      "required": [
        "id",
        "timeoutSeconds",
        "unmetMessage",
        "type",
        "sourceKind",
        "sourceName",
        "key",
        "expectedValue"
      ],
      "title": "ConfigValueCheck",
      "type": "object"
    },
    "ContainerImageCheck": {
      "additionalProperties": false,
      "properties": {
        "container": {
          "maxLength": 253,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$",
          "title": "Container",
          "type": "string"
        },
        "expectedImage": {
          "minLength": 1,
          "title": "Expectedimage",
          "type": "string"
        },
        "id": {
          "maxLength": 63,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9-]{1,62}$",
          "title": "Id",
          "type": "string"
        },
        "timeoutSeconds": {
          "maximum": 120,
          "minimum": 1,
          "title": "Timeoutseconds",
          "type": "integer"
        },
        "type": {
          "const": "container_image",
          "title": "Type",
          "type": "string"
        },
        "unmetMessage": {
          "minLength": 1,
          "title": "Unmetmessage",
          "type": "string"
        },
        "workloadKind": {
          "enum": [
            "Pod",
            "Deployment",
            "StatefulSet",
            "DaemonSet",
            "Job",
            "CronJob"
          ],
          "title": "Workloadkind",
          "type": "string"
        },
        "workloadName": {
          "maxLength": 253,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$",
          "title": "Workloadname",
          "type": "string"
        }
      },
      "required": [
        "id",
        "timeoutSeconds",
        "unmetMessage",
        "type",
        "workloadKind",
        "workloadName",
        "container",
        "expectedImage"
      ],
      "title": "ContainerImageCheck",
      "type": "object"
    },
    "DeploymentAvailableCheck": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 63,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9-]{1,62}$",
          "title": "Id",
          "type": "string"
        },
        "minimumReplicas": {
          "maximum": 20,
          "minimum": 1,
          "title": "Minimumreplicas",
          "type": "integer"
        },
        "name": {
          "maxLength": 253,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$",
          "title": "Name",
          "type": "string"
        },
        "timeoutSeconds": {
          "maximum": 120,
          "minimum": 1,
          "title": "Timeoutseconds",
          "type": "integer"
        },
        "type": {
          "const": "deployment_available",
          "title": "Type",
          "type": "string"
        },
        "unmetMessage": {
          "minLength": 1,
          "title": "Unmetmessage",
          "type": "string"
        }
      },
      "required": [
        "id",
        "timeoutSeconds",
        "unmetMessage",
        "type",
        "name",
        "minimumReplicas"
      ],
      "title": "DeploymentAvailableCheck",
      "type": "object"
    },
    "HttpResponseCheck": {
      "additionalProperties": false,
      "properties": {
        "expectedStatus": {
          "maximum": 599,
          "minimum": 100,
          "title": "Expectedstatus",
          "type": "integer"
        },
        "id": {
          "maxLength": 63,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9-]{1,62}$",
          "title": "Id",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/HttpTarget"
        },
        "timeoutSeconds": {
          "maximum": 120,
          "minimum": 1,
          "title": "Timeoutseconds",
          "type": "integer"
        },
        "type": {
          "const": "http_response",
          "title": "Type",
          "type": "string"
        },
        "unmetMessage": {
          "minLength": 1,
          "title": "Unmetmessage",
          "type": "string"
        }
      },
      "required": [
        "id",
        "timeoutSeconds",
        "unmetMessage",
        "type",
        "target",
        "expectedStatus"
      ],
      "title": "HttpResponseCheck",
      "type": "object"
    },
    "HttpTarget": {
      "additionalProperties": false,
      "description": "Cluster-internal HTTP target; raw URLs are deliberately not supported.",
      "properties": {
        "mode": {
          "enum": [
            "service",
            "ingress"
          ],
          "title": "Mode",
          "type": "string"
        },
        "name": {
          "maxLength": 253,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$",
          "title": "Name",
          "type": "string"
        },
        "path": {
          "default": "/",
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "^/",
          "title": "Path",
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "scheme": {
          "default": "http",
          "enum": [
            "http",
            "https"
          ],
          "title": "Scheme",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "name",
        "port"
      ],
      "title": "HttpTarget",
      "type": "object"
    },
    "LabCleanup": {
      "additionalProperties": false,
      "description": "The only cleanup action permitted in v1alpha1.",
      "properties": {
        "deleteNamespace": {
          "const": true,
          "title": "Deletenamespace",
          "type": "boolean"
        }
      },
      "required": [
        "deleteNamespace"
      ],
      "title": "LabCleanup",
      "type": "object"
    },
    "LabEnvironment": {
      "additionalProperties": false,
      "description": "Declarative namespace and manifest inputs for the faulty environment.",
      "properties": {
        "manifests": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Manifests",
          "type": "array"
        },
        "namespace": {
          "maxLength": 63,
          "minLength": 10,
          "pattern": "^kubelab-[a-z0-9](?:[a-z0-9-]{0,53}[a-z0-9])?$",
          "title": "Namespace",
          "type": "string"
        },
        "provisionTimeoutSeconds": {
          "maximum": 300,
          "minimum": 10,
          "title": "Provisiontimeoutseconds",
          "type": "integer"
        }
      },
      "required": [
        "namespace",
        "manifests",
        "provisionTimeoutSeconds"
      ],
      "title": "LabEnvironment",
      "type": "object"
    },
    "LabHint": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "level": {
          "maximum": 3,
          "minimum": 1,
          "title": "Level",
          "type": "integer"
        }
      },
      "required": [
        "level",
        "content"
      ],
      "title": "LabHint",
      "type": "object"
    },
    "LabInterview": {
      "additionalProperties": false,
      "properties": {
        "questions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Questions",
          "type": "array"
        }
      },
      "required": [
        "questions"
      ],
      "title": "LabInterview",
      "type": "object"
    },
    "LabMetadata": {
      "additionalProperties": false,
      "description": "Human-facing identity and catalogue data for one lab.",
      "properties": {
        "category": {
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$",
          "title": "Category",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",

        },
        "id": {
          "maxLength": 63,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9-]{1,62}$",
          "title": "Id",
          "type": "string"
        },
        "maximumRestartCount": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximumrestartcount"
        },
        "minimumCount": {
          "default": 1,
          "minimum": 1,
          "title": "Minimumcount",
          "type": "integer"
        },
        "minimumReady": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimumready"
        },
        "minimumRestartCount": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimumrestartcount"
        },
        "ready": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ready"
        },
        "selector": {
          "minProperties": 1,
          "patternProperties": {
            "^[a-z][a-z0-9-]*$": {
              "minLength": 1,
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 63,
            "minLength": 1
          },
          "title": "Selector",
          "type": "object"
        },
        "stableSeconds": {
          "anyOf": [
            {
              "maximum": 120,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stableseconds"
        },
        "timeoutSeconds": {
          "maximum": 120,
          "minimum": 1,
          "title": "Timeoutseconds",
          "type": "integer"
        },
        "type": {
          "const": "pod_status",
          "title": "Type",
          "type": "string"
        },
        "unmetMessage": {
          "minLength": 1,
          "title": "Unmetmessage",
          "type": "string"
        }
      },
      "required": [
        "id",
        "timeoutSeconds",
        "unmetMessage",
        "type",
        "selector",
        "expectedPhase"
      ],
      "title": "PodStatusCheck",
      "type": "object"
    },
    "PvcStatusCheck": {

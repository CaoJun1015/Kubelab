        "successMessage"
      ],
      "title": "LabTask",
      "type": "object"
    },
    "PodStatusCheck": {
      "additionalProperties": false,
      "properties": {
        "containerName": {
          "anyOf": [
            {
              "maxLength": 253,
              "minLength": 1,
              "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$",

{
  "$defs": {
    "LabPackageMetadata": {
      "additionalProperties": false,
      "properties": {
        "labId": {
          "maxLength": 40,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9-]{2,39}$",
          "title": "Labid",
          "type": "string"
        },
        "publisherId": {
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$",
          "title": "Publisherid",
          "type": "string"
        },
        "publisherName": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Publishername",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 5,
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "labId",
        "version",
        "publisherId",
        "publisherName"
      ],
      "title": "LabPackageMetadata",
      "type": "object"
    },
    "LabPackageSpec": {
      "additionalProperties": false,
      "properties": {
        "requiresKubelab": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Requireskubelab",
          "type": "string"
        }
      },
      "required": [
        "requiresKubelab"
      ],
      "title": "LabPackageSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "kubelab.io/v1alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "kind": {
      "const": "LabPackage",
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/LabPackageMetadata"
    },
    "spec": {
      "$ref": "#/$defs/LabPackageSpec"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "LabPackageDefinition",
  "type": "object"
}

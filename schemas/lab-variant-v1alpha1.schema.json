  "additionalProperties": false,
  "description": "Strict fixed variant definition scoped by its parent lab directory.",
  "properties": {
    "apiVersion": {
      "const": "kubelab.io/v1alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "environment": {
      "$ref": "#/$defs/LabVariantEnvironment"
    },
    "hints": {
      "items": {
        "$ref": "#/$defs/LabHint"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Hints",
      "type": "array"
    },
    "initialChecks": {
      "items": {
        "discriminator": {
          "mapping": {
            "config_value": "#/$defs/ConfigValueCheck",
            "container_image": "#/$defs/ContainerImageCheck",
            "deployment_available": "#/$defs/DeploymentAvailableCheck",
            "dns_resolution": "#/$defs/DnsResolutionCheck",
            "http_response": "#/$defs/HttpResponseCheck",
            "pod_status": "#/$defs/PodStatusCheck",
            "pvc_status": "#/$defs/PvcStatusCheck",
            "resource_exists": "#/$defs/ResourceExistsCheck",
            "service_endpoint_count": "#/$defs/ServiceEndpointCountCheck"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ResourceExistsCheck"
          },
          {
            "$ref": "#/$defs/PodStatusCheck"
          },
          {
            "$ref": "#/$defs/DeploymentAvailableCheck"
          },
          {
            "$ref": "#/$defs/ServiceEndpointCountCheck"
          },
          {
            "$ref": "#/$defs/ContainerImageCheck"
          },
          {
            "$ref": "#/$defs/ConfigValueCheck"
          },
          {
            "$ref": "#/$defs/PvcStatusCheck"
          },
          {
            "$ref": "#/$defs/HttpResponseCheck"
          },
          {
            "$ref": "#/$defs/DnsResolutionCheck"
          }
        ]
      },
      "minItems": 1,
      "title": "Initialchecks",
      "type": "array"
    },
    "kind": {
      "const": "LabVariant",
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/LabVariantMetadata"
    },
    "reveal": {
      "$ref": "#/$defs/LabVariantReveal"
    },
    "successChecks": {
      "items": {
        "discriminator": {
          "mapping": {
            "config_value": "#/$defs/ConfigValueCheck",
            "container_image": "#/$defs/ContainerImageCheck",
            "deployment_available": "#/$defs/DeploymentAvailableCheck",
            "dns_resolution": "#/$defs/DnsResolutionCheck",
            "http_response": "#/$defs/HttpResponseCheck",
            "pod_status": "#/$defs/PodStatusCheck",
            "pvc_status": "#/$defs/PvcStatusCheck",
            "resource_exists": "#/$defs/ResourceExistsCheck",
            "service_endpoint_count": "#/$defs/ServiceEndpointCountCheck"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ResourceExistsCheck"
          },
          {
            "$ref": "#/$defs/PodStatusCheck"
          },
          {
            "$ref": "#/$defs/DeploymentAvailableCheck"
          },
          {
            "$ref": "#/$defs/ServiceEndpointCountCheck"
          },
          {
            "$ref": "#/$defs/ContainerImageCheck"
          },
          {
            "$ref": "#/$defs/ConfigValueCheck"
          },
          {
            "$ref": "#/$defs/PvcStatusCheck"
          },
          {
            "$ref": "#/$defs/HttpResponseCheck"
          },
          {
            "$ref": "#/$defs/DnsResolutionCheck"
          }
        ]

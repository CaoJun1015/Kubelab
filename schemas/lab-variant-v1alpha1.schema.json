          "title": "Timeoutseconds",
          "type": "integer"
        },
        "type": {
          "const": "pvc_status",
          "title": "Type",
          "type": "string"
        },
        "unmetMessage": {
          "minLength": 1,
          "title": "Unmetmessage",
          "type": "string"
        }
      },
      "required": [
        "id",
        "timeoutSeconds",
        "unmetMessage",
        "type",
        "name",
        "expectedPhase"
      ],
      "title": "PvcStatusCheck",
      "type": "object"
    },
    "ResourceExistsCheck": {

            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stableseconds"
        },
        "timeoutSeconds": {
          "maximum": 120,
          "minimum": 1,
          "title": "Timeoutseconds",
          "type": "integer"
        },
        "type": {
          "const": "pod_status",
          "title": "Type",
          "type": "string"
        },
        "unmetMessage": {
          "minLength": 1,
          "title": "Unmetmessage",
          "type": "string"
        }
      },
      "required": [
        "id",
        "timeoutSeconds",
        "unmetMessage",
        "type",
        "selector",
        "expectedPhase"
      ],
      "title": "PodStatusCheck",
      "type": "object"
    },
    "PvcStatusCheck": {
      "additionalProperties": false,

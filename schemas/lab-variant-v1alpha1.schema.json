        },
        "id": {
          "maxLength": 63,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9-]{1,62}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 253,
          "minLength": 1,
